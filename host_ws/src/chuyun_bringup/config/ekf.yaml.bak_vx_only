ekf_filter_node:
  ros__parameters:
    frequency: 30.0
    sensor_timeout: 0.2
    two_d_mode: true
    transform_time_offset: 0.0
    transform_timeout: 0.1
    print_diagnostics: true
    publish_tf: true
    publish_acceleration: false

    map_frame: map
    odom_frame: odom
    base_link_frame: base_footprint
    world_frame: odom

    odom0: /odom/ekf_input
    # Only fuse the forward speed. Absolute x/y come from wheel odometry whose
    # heading is wrong (wheels slip), so fusing them pins the EKF position to a
    # trajectory that disagrees with the gyro heading -> star-shaped maps.
    # Position is now dead-reckoned here from vx + gyro yaw; slam corrects it.
    odom0_config: [false, false, false,
                   false, false, false,
                   true,  false, false,
                   false, false, false,
                   false, false, false]
    odom0_queue_size: 10
    odom0_nodelay: true
    odom0_differential: false
    odom0_relative: false

    imu0: /imu/ekf_input
    # fuse only the (bias-corrected) yaw rate
    imu0_config: [false, false, false,
                  false, false, false,
                  false, false, false,
                  false, false, true,
                  false, false, false]
    imu0_queue_size: 20
    imu0_nodelay: true
    imu0_differential: false
    imu0_relative: false
    imu0_remove_gravitational_acceleration: true
    # Disable Mahalanobis gating: after a large jump robot_localization started
    # rejecting every IMU sample, freezing the yaw state (observed: yaw stuck at
    # a constant value for >10 minutes while the robot kept turning).
    imu0_twist_rejection_threshold: 1.0e9
    odom0_twist_rejection_threshold: 1.0e9
    odom0_pose_rejection_threshold: 1.0e9
    dynamic_process_noise_covariance: true
